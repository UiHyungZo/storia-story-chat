# macOS
.DS_Store

# Node / Expo (apps/client)
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.env
.env.local

# React Native / iOS / Android
apps/client/ios/Pods/
apps/client/ios/build/
apps/client/android/build/
apps/client/android/.gradle/
apps/client/android/app/build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Java / Gradle (apps/backend)
apps/backend/build/
apps/backend/.gradle/
apps/backend/out/
*.class
HELP.md

# IDE
.idea/
.vscode/
*.iml

# OMC (Claude Code plugin) local session state
.omc/

# Docker volumes / local env
.env.*.local

# Service account / credential keys — never commit these regardless of where they land
*service-account*.json
*-sa.json
*firebase-adminsdk*.json
# GCP downloads a service-account key named "<project-id>-<hash>.json" with no other
# marker, so match that shape too (both our projects' ids).
storia-*-[0-9a-f]*.json
*.pem
