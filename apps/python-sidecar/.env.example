# 백엔드(apps/backend)와 같은 LiveKit 프로젝트 자격증명 (LiveKit Cloud 콘솔에서 확인)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# 기존 Spring 백엔드 REST API 주소 — 여기로 메시지를 그대로 위임한다
STORIA_BACKEND_URL=http://localhost:8080

# livekit-plugins-google(STT/TTS)은 apps/backend의 STT_API_KEY/TTS_API_KEY(단순 API 키)와
# 달리 서비스 계정 JSON을 요구한다. 같은 GCP 프로젝트라도 별도로 발급받아야 함.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
