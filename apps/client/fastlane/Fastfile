# Storia release automation.
#
# Assumes the native projects already exist (`npx expo prebuild` is run by the
# GitHub Actions workflow before these lanes, so local and CI stay identical).
#
# iOS   -> build signed IPA, upload to TestFlight
# Android -> build signed AAB, upload to Play "internal" track
#
# Every credential comes from the environment. See docs/deployment.md for the
# full secret list and the one-time local setup.

default_platform(:ios)

# Build number / Android versionCode. In CI this is the workflow run number so
# every release is monotonic without querying the stores; locally it falls back
# to a timestamp.
BUILD_NUMBER = (ENV["BUILD_NUMBER"] && !ENV["BUILD_NUMBER"].empty? ? ENV["BUILD_NUMBER"] : Time.now.strftime("%y%m%d%H%M")).to_i

def load_asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"), # base64 of the .p8
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  desc "Build a signed IPA and ship it to TestFlight"
  lane :beta do
    setup_ci # ephemeral keychain on CI, no-op locally

    api_key = load_asc_api_key

    # App Store distribution cert + provisioning profile from the private
    # `storia-certificates` repo (MATCH_GIT_URL). readonly on CI.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci
    )

    increment_build_number(
      xcodeproj: "ios/Storia.xcodeproj",
      build_number: BUILD_NUMBER
    )

    build_app(
      workspace: "ios/Storia.xcworkspace",
      scheme: "Storia",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.storia.client" => "match AppStore com.storia.client"
        }
      },
      output_directory: "build/ios",
      output_name: "Storia.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end

platform :android do
  desc "Build a signed AAB and ship it to the Play internal track"
  lane :beta do
    # The workflow writes the keystore from a base64 secret to this path and
    # exports STORIA_UPLOAD_* into the environment. The Gradle release
    # signingConfig (added by plugins/withAndroidReleaseSigning.js) reads them
    # as project properties.
    keystore = ENV.fetch("STORIA_UPLOAD_STORE_FILE")
    UI.user_error!("keystore not found at #{keystore}") unless File.exist?(keystore)

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: {
        "STORIA_UPLOAD_STORE_FILE"     => File.expand_path(keystore),
        "STORIA_UPLOAD_STORE_PASSWORD" => ENV.fetch("STORIA_UPLOAD_STORE_PASSWORD"),
        "STORIA_UPLOAD_KEY_ALIAS"      => ENV.fetch("STORIA_UPLOAD_KEY_ALIAS"),
        "STORIA_UPLOAD_KEY_PASSWORD"   => ENV.fetch("STORIA_UPLOAD_KEY_PASSWORD"),
        "STORIA_VERSION_CODE"          => BUILD_NUMBER
      }
    )

    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV.fetch("PLAY_JSON_KEY_FILE"),
      release_status: "draft",       # promote to "completed" in Play Console after a smoke test
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
