# Both platforms share the same identifier.
app_identifier "com.storia.client"

# Apple account. `pilot`/`deliver` use this for the account context, not signing.
apple_id ENV["APPLE_ID"] || "lukaend@naver.com"
team_id ENV["APPLE_TEAM_ID"] || "9G5T5K3BP2"

# Android: the Play service-account JSON path, injected by CI (see fastlane/Fastfile).
for_platform :android do
  json_key_file ENV["PLAY_JSON_KEY_FILE"] || "fastlane/play-service-account.json"
  package_name "com.storia.client"
end
