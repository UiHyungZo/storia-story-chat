# Code signing via fastlane match, stored in a SEPARATE PRIVATE git repo
# (this app repo is public — certificates must never live here).
#
# One-time setup (run locally, see docs/deployment.md):
#   bundle exec fastlane match init
#   MATCH_GIT_URL=git@github.com:<you>/storia-certificates.git \
#     bundle exec fastlane match appstore
#
git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")

type("appstore")            # distribution profile for TestFlight / App Store
app_identifier(["com.storia.client"])

# `match` authenticates to the Apple Developer portal with the App Store Connect
# API key (set up in the Fastfile via app_store_connect_api_key), so no
# username/password prompt on CI.
readonly(is_ci)
